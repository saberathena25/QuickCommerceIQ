table fact_orders
	lineageTag: f854bfe9-71f4-57b1-a74b-8948766d9c84

	measure 'Total Orders' = COUNTROWS(fact_orders)
		formatString: #,##0
		lineageTag: 2e0b9519-d2a1-5d80-b030-340841b068ec

	measure 'Delivered Orders' = CALCULATE(COUNTROWS(fact_orders), fact_orders[order_status] = "DELIVERED")
		formatString: #,##0
		lineageTag: 6d5253ad-76db-58e4-8bf0-6368f1f21355

	measure 'Total GMV (INR)' = SUM(fact_orders[cart_value])
		formatString: "₹"#,##,##0
		lineageTag: fb6eb3f0-5f0a-57f3-9ce9-d9f89a26b945

	measure 'Total NCM (INR)' = SUM(fact_orders[net_contribution_margin])
		formatString: "₹"#,##,##0.00
		lineageTag: 09a1da09-9647-5979-acfb-582df08937eb

	measure 'NCM per Order (INR)' = DIVIDE([Total NCM (INR)], [Total Orders], 0)
		formatString: "₹"#,##0.00
		lineageTag: d2726bfa-b5ef-5417-a55a-f9504f22d02a

	measure 'Average Delivery Time (Min)' = CALCULATE(AVERAGE(fact_orders[total_delivery_minutes]), fact_orders[order_status] = "DELIVERED")
		formatString: 0.00
		lineageTag: 9b4b244f-9d22-5f17-b136-980a434ffc32

	measure 'Avg Picking Time (Min)' = CALCULATE(AVERAGE(fact_orders[picking_minutes]), fact_orders[order_status] = "DELIVERED")
		formatString: 0.00
		lineageTag: 5ad343ce-59fd-5e6a-9dc2-bd4632618578

	measure 'Avg Rider Assignment Time (Min)' = CALCULATE(AVERAGE(fact_orders[assignment_minutes]), fact_orders[order_status] = "DELIVERED")
		formatString: 0.00
		lineageTag: 201e0ac1-b308-5990-9379-04792304beed

	measure 'Avg Transit Time (Min)' = CALCULATE(AVERAGE(fact_orders[transit_minutes]), fact_orders[order_status] = "DELIVERED")
		formatString: 0.00
		lineageTag: eadbf12b-a75d-5c82-be1c-6dafcd4d9452

	measure 'SLA Breach Count' = CALCULATE(COUNTROWS(fact_orders), fact_orders[order_status] = "DELIVERED", fact_orders[is_sla_breach] = TRUE())
		formatString: #,##0
		lineageTag: c9281f75-2b90-5849-8179-f1182788272f

	measure 'SLA Breach Rate %' = DIVIDE([SLA Breach Count], [Delivered Orders], 0)
		formatString: 0.00%
		lineageTag: 1a68840e-44bc-5c1c-a63c-2a1163b07cff

