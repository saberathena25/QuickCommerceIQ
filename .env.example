# QuickCommerceIQ Environment Configuration
# Copy this file to .env and update values for your local PostgreSQL instance.

# Database backend: 'postgres' (recommended) or 'sqlite' (zero-setup local fallback)
DB_BACKEND=postgres

# PostgreSQL Connection Settings
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=quickcommerce_iq
POSTGRES_USER=qc_admin
POSTGRES_PASSWORD=change_me_local_password

# Full SQLAlchemy connection string (overrides individual POSTGRES_* vars if set)
DATABASE_URL=postgresql+psycopg://qc_admin:change_me_local_password@localhost:5432/quickcommerce_iq

# Local SQLite fallback path (used when DB_BACKEND=sqlite or --local-db is passed)
SQLITE_DB_PATH=data/processed/quickcommerce_warehouse.db

# Pipeline & Simulation Settings
RANDOM_SEED=42
TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO
STRICT_QUALITY_GATE=true
